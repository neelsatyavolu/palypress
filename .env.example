# Copy to .env (Expo / local Node) or .dev.vars (Cloudflare Worker) and fill in.
# Never commit the filled-in file.

# Server
DATABASE_URL=postgres://user:password@host:5432/dbname
SESSION_SECRET=
ENCRYPTION_KEY=
ADMIN_PASSWORD=
APP_URL=

# Email (Resend)
RESEND_API_KEY=
FROM_EMAIL=
TEAM_EMAIL=

# Sign-in
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
APPLE_CLIENT_ID=

# WordPress comment relay (optional)
WP_USERNAME=
WP_PASSWORD=
WP_PROXY_URL=
WP_PROXY_KEY=

# Client (bundled into the app, so not secret)
EXPO_PUBLIC_DOMAIN=localhost:5000
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
