{
  "name": "paly-press",
  "main": "client/index.js",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "npm run server:dev",
    "expo": "npx expo start --localhost",
    "expo:dev": "EXPO_PACKAGER_PROXY_URL=https://$REPLIT_DEV_DOMAIN REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN:5000 npx expo start --localhost",
    "server:dev": "NODE_ENV=development tsx server/index.ts",
    "expo:start:static:build": "npx expo start --no-dev --minify --localhost",
    "expo:static:build": "node scripts/build.js",
    "server:build": "esbuild server/index.ts --platform=node --packages=external --bundle --format=cjs --outdir=server_dist",
    "server:build:prod": "npm run test:auth:apple && esbuild server/index.ts --platform=node --packages=external --bundle --format=cjs --outdir=server_dist",
    "test:auth:apple": "node --experimental-global-webcrypto --import tsx --test server/appleAuth.test.ts server/appleSignInFlow.test.ts server/appleAuthVerification.test.ts",
    "server:prod": "NODE_ENV=production node server_dist/index.js",
    "worker:assets": "rm -rf .worker-assets && mkdir -p .worker-assets && cp -R assets .worker-assets/assets",
    "worker:dev": "npm run worker:assets && wrangler dev",
    "worker:deploy": "npm run test:auth:apple && npm run worker:assets && wrangler deploy",
    "db:push": "drizzle-kit push",
    "lint": "npx expo lint",
    "lint:fix": "npx expo lint --fix",
    "check:types": "tsc --noEmit",
    "check:format": "prettier --check \"**/*.{js,ts,tsx,css,json}\"",
    "format": "prettier --write \"**/*.{js,ts,tsx,css,json}\"",
    "postinstall": "patch-package",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@neondatabase/serverless": "^0.10.4",
    "@posthog/cli": "^0.7.33",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^8.6.0",
